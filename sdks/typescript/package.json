{
  "name": "@isola-run/sdk",
  "version": "0.6.0",
  "description": "TypeScript SDK for the Isola sandbox platform",
  "license": "Apache-2.0",
  "homepage": "https://github.com/isola-run/isola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isola-run/isola.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/isola-run/isola/issues"
  },
  "keywords": [
    "isola",
    "sandbox",
    "kubernetes",
    "ai",
    "code-execution"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check src tests examples smoke",
    "lint:fix": "biome check --write src tests examples smoke",
    "typecheck": "tsc --noEmit",
    "verify-package": "pnpm build && attw --pack . && publint",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.4",
    "publint": "0.3.20",
    "tsdown": "0.22.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "4.1.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
